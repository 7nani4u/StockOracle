# StockOracle 환경변수 템플릿 — 실제 키는 절대 커밋 금지
# Vercel Dashboard → Settings → Environment Variables 에 동일하게 설정

# 미국 보조 시세 (없어도 yfinance+Naver로 동작, 있으면 정확도↑)
# AlphaVantage는 ALPHAVANTAGE_KEY 우선, ALPHAVANTAGE_API_KEY도 호환
TIINGO_API_KEY=
ALPHAVANTAGE_KEY=
# ALPHAVANTAGE_API_KEY=  # 구명 호환용 (위와 둘 중 하나만 설정)
FINNHUB_API_KEY=

# 텔레그램 전송 (미설정 시 /api/telegram/send 는 설정없음 에러 반환)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 국내 개장급등 추적 저널 (미설정 시 OS tmp, Vercel은 /tmp — 재배포 시 유실)
# KR_SURGE_TRACKING_PATH=
# KR_SURGE_SHORT_OVERHEAT_URL=
# KR_SURGE_SHORT_OVERHEAT_TOKEN=
# KR_SURGE_SHORT_OVERHEAT_CODES=

# TTL 참고 (코드 내장, env 아님):
# Naver 5s / YFDirect 30s / yfinance info 30s / AV 120s / 매크로 장중180s·미장300s·장외600s
